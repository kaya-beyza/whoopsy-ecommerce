# Database (Neon PostgreSQL)
ConnectionStrings__DefaultConnection=Host=BURAYA_HOST_GIRIN;Port=5432;Database=BURAYA_DB_ADI_GIRIN;Username=BURAYA_KULLANICI_GIRIN;Password=BURAYA_DB_SIFRESI_GIRIN;SSLMode=Require;Trust Server Certificate=true

# JWT (en az 32 karakterlik random secret — openssl rand -base64 64 ile üret)
Jwt__SecretKey=BURAYA_EN_AZ_32_KARAKTERLIK_GIZLI_ANAHTAR

# Cloudinary
Cloudinary__CloudName=BURAYA_CLOUDINARY_CLOUD_NAME
Cloudinary__ApiKey=BURAYA_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=BURAYA_CLOUDINARY_API_SECRET

# Iyzico (sandbox)
Iyzico__ApiKey=BURAYA_IYZICO_API_KEY
Iyzico__SecretKey=BURAYA_IYZICO_SECRET_KEY

# SMTP (Gmail App Password ile)
# myaccount.google.com → Security → 2-Step Verification → App passwords'tan üret
Smtp__Username=BURAYA_GMAIL_ADRESI@gmail.com
Smtp__Password=BURAYA_GMAIL_APP_PASSWORD
Smtp__FromEmail=BURAYA_GMAIL_ADRESI@gmail.com

# Dev/test override — boş değilse TÜM mailler bu adrese yönlendirilir.
# Smtp__OverrideRecipient=test@example.com
# Admin Approval Flow
# GatePassword: admin başvuru formuna erişmek için gerekli ön şifre (spam koruması)
# NotificationEmail: yeni başvuru onay maillerinin gideceği adres
# ApiBaseUrl: onay/red linklerinde kullanılır (lokal: http://localhost:5277)
AdminApproval__GatePassword=BURAYA_GIZLI_ADMIN_GATE_SIFRESI
AdminApproval__NotificationEmail=BURAYA_ADMIN_ONAY_MAIL_ADRESI@gmail.com
AdminApproval__ApiBaseUrl=http://localhost:5277

# Bootstrap Admin
# Sistemin kurucu admin'i (başvurusuz, otomatik onaylı). Boş bırakılırsa seed atlanır.
BootstrapAdmin__Email=BURAYA_KURUCU_ADMIN_MAIL@gmail.com
BootstrapAdmin__Password=BURAYA_KURUCU_ADMIN_SIFRESI
